---
---
{%- comment -%}
Search index for terminology-search.html, built by Jekyll from the CodeSystems the
publisher writes to _data (produce-jekyll-data). One object per CodeSystem, followed
by one [code, display, lang, value, ...] array per concept.
{%- endcomment -%}
[{"v":1}
{% for entry in site.data -%}
{%- assign key = entry[0] -%}
{%- assign prefix = key | slice: 0, 11 -%}
{%- if prefix == "CodeSystem-" -%}
{%- assign cs = entry[1] -%}
,{"id":{{ cs.id | jsonify }},"t":{{ cs.title | default: cs.name | jsonify }},"u":{{ cs.url | jsonify }},"l":{{ cs.language | default: "" | jsonify }},"k":{{ cs.content | jsonify }}}
{% include concept-index-rows.html concepts=cs.concept -%}
{%- endif -%}
{%- endfor -%}
]
