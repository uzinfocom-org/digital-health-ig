---
---
{%- comment -%}
Search index for search.html, built by Jekyll from the resources the publisher writes to
_data (produce-jekyll-data). One object per resource, followed by one array per item in it:
["c", code, display, lang, value, ...] for a CodeSystem or ValueSet concept,
["m", source code, source display, target code, target display, relationship] for a
ConceptMap mapping and ["n", value, type] for a NamingSystem identifier.
{%- endcomment -%}
[{"v":2}
{% for entry in site.data -%}
{%- assign r = entry[1] -%}
{%- if r.resourceType and r.id -%}
{%- assign expected = r.resourceType | append: "-" | append: r.id -%}
{%- if entry[0] == expected -%}
{%- assign d = r.description -%}
{%- if d.text -%}{%- assign d = d.text -%}{%- elsif d.coding -%}{%- assign d = d.coding[0].display -%}{%- endif -%}
,{"r":{{ r.resourceType | jsonify }},"id":{{ r.id | jsonify }},"t":{{ r.title | default: r.name | default: r.id | jsonify }},"n":{{ r.name | default: "" | jsonify }},"u":{{ r.url | default: "" | jsonify }},"d":{{ d | default: "" | strip_newlines | truncate: 300 | jsonify }}}
{% case r.resourceType -%}
{%- when "CodeSystem" -%}{% include search-index-concepts.html concepts=r.concept -%}
{%- when "ValueSet" -%}{%- for inc in r.compose.include -%}{% if inc.concept %}{% include search-index-concepts.html concepts=inc.concept -%}{% endif %}{%- endfor -%}
{%- when "ConceptMap" -%}{%- for g in r.group -%}{%- for e in g.element -%}
{%- if e.target == nil or e.target.size == 0 -%}
,["m",{{ e.code | jsonify }},{{ e.display | default: "" | jsonify }},"","","noMap"]
{% endif -%}
{%- for t in e.target -%}
,["m",{{ e.code | jsonify }},{{ e.display | default: "" | jsonify }},{{ t.code | default: "" | jsonify }},{{ t.display | default: "" | jsonify }},{{ t.relationship | default: "" | jsonify }}]
{% endfor -%}{%- endfor -%}{%- endfor -%}
{%- when "NamingSystem" -%}{%- for u in r.uniqueId -%}
,["n",{{ u.value | jsonify }},{{ u.type | jsonify }}]
{% endfor -%}
{%- endcase -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
]
