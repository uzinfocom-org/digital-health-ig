@startuml lab-sequence
title Ordering a test and returning the result
autonumber

actor "Ordering\nclinician" as Clin
participant "DHP\nFHIR server" as DHP
participant "Laboratory\n(LIS)" as Lab

Clin -> DHP : POST ServiceRequest (intent = order)
activate DHP
DHP --> Clin : 201 Created - ServiceRequest/[id]
deactivate DHP

DHP -> Lab : order available
Lab -> DHP : POST Specimen\n(request -> ServiceRequest)
activate DHP
DHP --> Lab : 201 Created - Specimen/[id]
deactivate DHP

loop each analyte
  Lab -> DHP : POST Observation\n(basedOn -> ServiceRequest, specimen -> Specimen)
end
Lab -> DHP : POST DiagnosticReport\n(basedOn -> ServiceRequest, result -> Observations)
note right of DHP : Best submitted as one\ntransaction Bundle

Clin -> DHP : GET Observation?based-on=ServiceRequest/[id]
activate DHP
DHP --> Clin : Bundle - results
deactivate DHP
@enduml
