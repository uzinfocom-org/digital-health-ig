CodeSystem: DischargeSummarySectionCS
Id: discharge-summary-section-cs
Title: "Discharge summary section"
Description: "Local discharge summary section codes in Uzbekistan for sections that have no LOINC equivalent"
* insert OriginalCodeSystemDraft(discharge-summary-section-cs)
* #epicris-0001-00002 "Hayot anamnezi (Anamnesis vitae)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Анамнез жизни (Anamnesis vitae)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Life history (Anamnesis vitae)"
* #epicris-0001-00003 "Epidemiologik anamnez"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Эпидемиологический анамнез"
  * ^designation[+].language = #en
  * ^designation[=].value = "Epidemiological history"
* #epicris-0001-00006 "Mahalliy status (Status localis)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Местный статус (Status localis)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Local status (Status localis)"
