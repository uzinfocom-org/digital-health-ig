CodeSystem: DiagnosisTypeCS
Id: diagnosis-type-cs
Title: "Diagnosis Types"
Description: "Diagnosis types in Uzbekistan"
* insert OriginalCodeSystemDraft(diagnosis-type-cs)
* #gencl-0001-00001 "Yo'naltiruvchi muassasaning tashxisi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагноз направившего учреждения"
  * ^designation[+].language = #en
  * ^designation[=].value = "Diagnosis of the referring institution"
* #gencl-0001-00002 "Qabulxona tashxisi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагноз приемного покоя"
  * ^designation[+].language = #en
  * ^designation[=].value = "Diagnosis of the admission department"
* #gencl-0001-00003 "Asosiy tashxis"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагноз основной"
  * ^designation[+].language = #en
  * ^designation[=].value = "Main diagnosis"
* #gencl-0001-00004 "Qo'shimcha tashxis"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагноз сопутствующий"
  * ^designation[+].language = #en
  * ^designation[=].value = "Concomitant diagnosis"
* #gencl-0001-00005 "Asosiy kasallikning murakkabligi tashxisi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагноз осложнения основного заболевания"
  * ^designation[+].language = #en
  * ^designation[=].value = "Diagnosis of complications of the underlying disease"
* #gencl-0001-00006 "Raqobatdosh kasallik tashxisi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагноз конкурирующего заболевания"
  * ^designation[+].language = #en
  * ^designation[=].value = "Diagnosis of a competing disease"
* #gencl-0001-00007 "Fon kasalligi tashxisi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагноз фонового заболевания"
  * ^designation[+].language = #en
  * ^designation[=].value = "Diagnosis of a background disease"
* #gencl-0001-00008 "Yakuniy tashxis"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагноз заключительный"
  * ^designation[+].language = #en
  * ^designation[=].value = "Final diagnosis"
* #gencl-0001-00009 "Patomorfologik tashxis"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Патоморфологический диагноз"
  * ^designation[+].language = #en
  * ^designation[=].value = "Pathomorphological diagnosis"
* #gencl-0001-00010 "O'limga olib kelgan tashxis"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагноз, приведший к смерти"
  * ^designation[+].language = #en
  * ^designation[=].value = "Diagnosis leading to death"
* #gencl-0001-00011 "Patologik-anatomik tashxisi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Патологоанатомический диагноз"
  * ^designation[+].language = #en
  * ^designation[=].value = "Pathoanatomic diagnosis"
* #gencl-0001-00012 "Sud-tibbiy tashxis"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Судебно-медицинский диагноз"
  * ^designation[+].language = #en
  * ^designation[=].value = "Forensic medical diagnosis"


//Cancer diagnosis type codesystems
* #cancer-0003-0001 "RSNPMCOvaR filiali kasallik tarixi (ambulator karta)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "История болезни (амб. Карта) филиала РСНПМЦОиР"
  * ^designation[+].language = #en
  * ^designation[=].value = "Medical record (outpatient card) of a branch of the Republican Specialized Scientific and Practical Medical Center of Oncology and Radiology"

* #cancer-0003-0002 "Boshqa tibbiyot muassasasining kasallik tarixidan (ambulator kartasidan) ko‘chirma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Выписка из истории болезни (амб.карты) другого медицинского учреждения"
  * ^designation[+].language = #en
  * ^designation[=].value = "Extract from the medical record (outpatient card) of another medical institution"

* #cancer-0003-0003 "RSNPMCOvaR filiali xabarnomasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Извещение филиала РСНПМЦОиР"
  * ^designation[+].language = #en
  * ^designation[=].value = "Notification from a branch of the Republican Specialized Scientific and Practical Medical Center of Oncology and Radiology"

* #cancer-0003-0004 "Boshqa tibbiyot muassasasidan xabarnoma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Извещение из другого медицинского учреждения"
  * ^designation[+].language = #en
  * ^designation[=].value = "Notification from another medical institution"

* #cancer-0003-0005 "RMO/GMO xabarnomasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Извещение РМО/ГМО"
  * ^designation[+].language = #en
  * ^designation[=].value = "RMO/GMO notification"

* #cancer-0003-0006 "Bolalar onkologiyasi, gematologiyasi va immunologiyasi Respublika ilmiy-amaliy tibbiyot markazining kasallik tarixi yoki kasallik tarixidan (ambulator kartadan) ko‘chirma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "История болезни или выписка из истории болезни (амб.карта) РНПМЦ детской онкологии, гематологии и иммунологии"
  * ^designation[+].language = #en
  * ^designation[=].value = "Medical record or extract from the medical record (outpatient card) of the Republican Scientific and Practical Medical Center of Pediatric Oncology, Hematology and Immunology"

* #cancer-0003-0007 "Respublika ixtisoslashtirilgan ilmiy-amaliy gematologiya tibbiyot markazi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "РСНПМЦ гематологии"
  * ^designation[+].language = #en
  * ^designation[=].value = "Republican Specialized Scientific and Practical Medical Center of Hematology"

* #cancer-0003-0008 "O‘lim haqidagi guvohnoma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Свидетельство о смерти"
  * ^designation[+].language = #en
  * ^designation[=].value = "Death certificate"

* #cancer-0003-0009 "FHDYO organi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "ЗАГС"
  * ^designation[+].language = #en
  * ^designation[=].value = "Civil Registry Office"

* #cancer-0003-0010 "Xususiy tibbiyot muassasasining kasallik tarixidan (ambulator kartasidan) ko‘chirma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Выписка из истории болезни (амб.карты) частного медицинского учреждения"
  * ^designation[+].language = #en
  * ^designation[=].value = "Extract from the medical record (outpatient card) of a private medical institution"