CodeSystem: InventoryUnitCS
Id: inventory-unit-cs
Title: "Inventory Unit Code System"
Description: "List of inventory units used in the Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(inventory-unit-cs)

* #invun-0001-00001 "Quti"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Коробка"
  * ^designation[+].language = #en
  * ^designation[=].value = "Box"

* #invun-0001-00002 "Qadoq"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Упаковка"
  * ^designation[+].language = #en
  * ^designation[=].value = "Package"

* #invun-0001-00003 "O'ram"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Пачка"
  * ^designation[+].language = #en
  * ^designation[=].value = "Pack"

* #invun-0001-00004 "To'plam"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Набор (комплект)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Set / kit"
