  * ^designation[0].language = #ru
  * ^designation[=].value = "Трансмаммарный"
  * ^designation[+].language = #en
  * ^designation[=].value = "Transmammary"

* #pharm-0001-0009 "Mahalliy"
  * ^designation[0].language = #ru
