CodeSystem: FlagCategoryCS
Id: flag-category-cs
Title: "Flag category translations"
Description: "Flag category supplement with translations in Uzbek and Russian"
* insert SupplementCodeSystem(flag-category-cs, $flag-category, 1.0.1)

* #diet
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диета"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Parhez"

* #drug
  * ^designation[0].language = #ru
  * ^designation[=].value = "Лекарственное средство"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Dori vositasi"

* #lab
  * ^designation[0].language = #ru
  * ^designation[=].value = "Лаборатория"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Laboratoriya"

* #admin
  * ^designation[0].language = #ru
  * ^designation[=].value = "Административная"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Ma’muriy"

* #contact
  * ^designation[0].language = #ru
  * ^designation[=].value = "Контакт с пациентом"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Bemor bilan bog‘lanish"

* #clinical
  * ^designation[0].language = #ru
  * ^designation[=].value = "Клиническая"
  * ^designation[+].language = #uz
