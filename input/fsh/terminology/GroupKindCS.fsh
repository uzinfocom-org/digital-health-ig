CodeSystem: GroupKindCS
Id: group-kind-cs
Title: "Group kind"
Description: "Local classifier describing the purpose or kind of a group, such as screening, vaccination and donation target groups and their outcome cohorts"
* insert OriginalCodeSystemDraft(group-kind-cs)

* #group-0001-00001 "Skriningning maqsadli guruhi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Целевая группа скрининга"
  * ^designation[+].language = #en
  * ^designation[=].value = "Screening target group"
* #group-0001-00002 "Vaksinatsiyaning maqsadli guruhi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Целевая группа вакцинации"
  * ^designation[+].language = #en
  * ^designation[=].value = "Vaccination target group"
* #group-0001-00003 "Donorlikning maqsadli guruhi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Целевая группа донации"
  * ^designation[+].language = #en
  * ^designation[=].value = "Donation target group"
* #group-0001-00004 "Chiqarib tashlangan bemorlar"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Исключенные пациенты"
  * ^designation[+].language = #en
  * ^designation[=].value = "Excluded patients"
