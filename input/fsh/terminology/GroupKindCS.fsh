  * ^designation[0].language = #ru
  * ^designation[=].value = "Прошедшие скрининг"
  * ^designation[+].language = #en
  * ^designation[=].value = "Screened patients"
* #group-0001-00007 "Skriningdan o'tmagan bemorlar"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Не прошедшие скрининг"
  * ^designation[+].language = #en
  * ^designation[=].value = "Overdue patients"
* #group-0001-00008 "Vaksina olgan bemorlar"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Получившие вакцину"
  * ^designation[+].language = #en
  * ^designation[=].value = "Vaccinated patients"
