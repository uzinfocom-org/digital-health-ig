* #group-0001-00010 "Donorlikni amalga oshirgan donorlar"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Прошедшие донацию"
  * ^designation[+].language = #en
  * ^designation[=].value = "Donors who completed donation"
