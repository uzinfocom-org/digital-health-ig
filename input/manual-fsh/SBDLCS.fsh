  * ^property[=].valueString = "0.2"
  * ^property[+].code = #performerLevel
  * ^property[=].valueString = "B"
  * ^property[+].code = #performerLevel
  * ^property[=].valueString = "C"
  * ^property[+].code = #effectiveFrom
  * ^property[=].valueDateTime = "2025-09-19"
* #SBDL-007390-3 "Uyqu va umurtqa arteriyalarini turli darajadagi torayishlari va berkilishi, demensiya, chuqur kognitiv buzilishlar, tiklanmagan chuqur nevrologik defitsit, bosh miya yarim sharlarida 5 sm dan katta bo'lgan ishemik kistalarni mavjudligi. Tashxislash, simptomatik va umumiy quvvatlantiruvchi konservativ davo, reabilitatsiya muolajalari uchun"
