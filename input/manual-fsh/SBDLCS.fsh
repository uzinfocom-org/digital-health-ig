CodeSystem: SBDLCS
Id: sbdl-cs
Title: "SBDL state-funded treatment criterion"
Description: "Criteria of the State Health Insurance Fund (SBDL codes) under which a patient's treatment is paid by the state, each tied to the ICD-10 codes it covers and the levels of medical organization that may provide it"
* insert OriginalCodeSystemDraft(sbdl-cs)
* ^property[0].code = #icd10
* ^property[=].description = "ICD-10 code, codes or code range the criterion covers, as the Fund writes them; a list is separated by ';'"
* ^property[=].type = #string
* ^property[+].code = #direction
* ^property[=].description = "Clinical direction of the criterion in the Fund's list"
* ^property[=].type = #string
* ^property[+].code = #section
* ^property[=].description = "Disease group within the direction"
* ^property[=].type = #string
* ^property[+].code = #variant
* ^property[=].description = "Number of the criterion within its disease group in the Fund's list"
* ^property[=].type = #string
* ^property[+].code = #performerLevel
* ^property[=].description = "Level of medical organization (A, B or C) that may provide the treatment; repeats when several levels may"
* ^property[=].type = #string
* ^property[+].code = #effectiveFrom
* ^property[=].description = "Date from which the criterion applies"
* ^property[=].type = #dateTime
* ^property[+].code = #effectiveTo
* ^property[=].description = "Date until which the criterion applies; absent while it still applies"
* ^property[=].type = #dateTime

