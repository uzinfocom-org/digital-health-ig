  * ^designation[+].language = #en
  * ^designation[=].value = "Any active tuberculosis, development of complications, cases requiring complex diagnostic and therapeutic methods (fibrobronchoscopy (FBS), biopsy, surgery), condition after unsuccessful outpatient treatment"
