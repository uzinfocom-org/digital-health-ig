// Generated from TXMK reyestr 2026-11-03_final.xlsx (via complete TXMK FHIR export).
// Standalone FHIR R5 FSH: no project-specific RuleSet dependency.
// 7-digit permanent concept IDs remain the FHIR codes; structural codes are properties.
// Classes/groups are classifications, NOT asserted parent-child/is-a relationships.
// Canonical URL is provisional; approve it before production use.

CodeSystem: UZTXMKCS
Id: uz-txmk
Title: "Uzbekistan National Medical Services Classifier (TXMK)"
Description: "National classification of medical services of Uzbekistan, approved by the Ministry of Health of the Republic of Uzbekistan, containing 10,699 concepts with full Uzbek, Russian, and English names."
* ^url = "https://terminology.dhp.uz/fhir/core/CodeSystem/uz-txmk"
* ^version = "1.0.0"
* ^name = "UZTXMKCS"
* ^status = #draft
* ^experimental = true
* ^date = "2026-11-03"
* ^language = #uz
* ^caseSensitive = true
* ^content = #complete
* ^count = 10732

// These properties let terminology clients distinguish class/group and build ValueSets.
// Do not equate TXMK structural classification with a clinical subsumption hierarchy.
* ^property[0].code = #structural-code
* ^property[=].description = "Original structural code (e.g. B02.01.001) assigned by TXMK"
* ^property[=].type = #string
* ^property[+].code = #service-class
* ^property[=].description = "TXMK class: A, B, C or D"
* ^property[=].type = #code
* ^property[+].code = #service-group
* ^property[=].description = "TXMK group (e.g. B02), useful for ValueSet selection"
* ^property[=].type = #code
* ^property[+].code = #service-subgroup
* ^property[=].description = "TXMK subgroup segment (e.g. 01)"
* ^property[=].type = #string

* ^property[+].code = #notSelectable
* ^property[=].uri = "http://hl7.org/fhir/concept-properties#notSelectable"
* ^property[=].description = "Grouping concept (TXMK class or group), not a billable/orderable service"
* ^property[=].type = #boolean

// Filters supported for ValueSet selection
* ^filter[0].code = #service-group
* ^filter[=].description = "Select concepts by TXMK group (e.g. B02)"
* ^filter[=].operator[0] = #=
* ^filter[=].operator[+] = #in
* ^filter[=].value = "A TXMK group code, e.g. B02"

