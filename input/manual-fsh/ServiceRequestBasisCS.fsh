  * ^designation[+].language = #en
  * ^designation[=].value = "Symptomatic and general supportive conservative treatment."
* #basis-0001-00656 "Kasallik bosqichidan kat'iy nazar, barcha simptomatik va umumiy quvvatlantiruvchi hamda xirurgik chora-tadbirlar"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Независимо от стадии заболевания, применяются все симптоматические, общеукрепляющие и хирургические меры."
  * ^designation[+].language = #en
  * ^designation[=].value = "Regardless of disease stage, all symptomatic, general supportive and surgical measures are applied."
* #basis-0001-00657 "Periaurikulyar bo'shlig'i va kistasini olib tashlash"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Удаление периурикулярной полости и кисты"
  * ^designation[+].language = #en
  * ^designation[=].value = "Removal of pericardial cavity and cyst"
* #basis-0001-00658 "Diagnostik koronarografiya va koronar stentlash amaliyoti va (yoki) sun'iy qon aylanish uskunasi yordamida hamda ishlab turgan yurakda kardiojarrohlik amaliyoti"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагностическая коронарная ангиография и коронарное стентирование и/или кардиохирургическое вмешательство с использованием аппарата искусственного кровообращения и на функционирующем сердце."
  * ^designation[+].language = #en
  * ^designation[=].value = "Diagnostic coronary angiography and coronary stenting and/or cardiac surgery with cardiopulmonary bypass and on the beating heart."
* #basis-0001-00659 "Diagnostik koronarografiya va koronar stentlash amaliyoti va (yoki) sun'iy qon aylanish uskunasi yordamida hamda ishlab turgan yurakda kardiojarrohlik amaliyoti komorbid holati mavjud bo'lganda"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагностическая коронарная ангиография и коронарное стентирование и/или операция с использованием аппарата искусственного кровообращения, а также кардиохирургическое вмешательство на функционирующем сердце при наличии сопутствующих заболеваний."
  * ^designation[+].language = #en
  * ^designation[=].value = "Diagnostic coronary angiography and coronary stenting and/or surgery with cardiopulmonary bypass, and cardiac surgery on the beating heart in the presence of comorbidities."
* #basis-0001-00660 "Agar surunkali yurak yetishmovchiligining II va III bosqichi, funksional sinfi III va IV rivojlangan bo'lsa, konservativ davo uchun"
  * ^designation[0].language = #ru
  * ^designation[=].value = "При развитии хронической сердечной недостаточности II и III стадий, функционального класса III и IV, показано консервативное лечение."
  * ^designation[+].language = #en
  * ^designation[=].value = "Conservative treatment is indicated in chronic heart failure stage II-III, functional class III-IV."
* #basis-0001-00661 "Diagnostik koronarografiya va koronar stentlash amaliyoti va (yoki) sun'iy qon aylanish uskunasi yordamida hamda ishlab turgan yurakda kardiojarrohlik amaliyoti kasalliklar komorbid holati mavjud bo'lganda"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Диагностическая коронарная ангиография и коронарное стентирование и/или операция с использованием аппарата искусственного кровообращения, а также кардиохирургическое вмешательство на функционирующем сердце при наличии сопутствующих заболеваний."
  * ^designation[+].language = #en
  * ^designation[=].value = "Diagnostic coronary angiography and coronary stenting and/or surgery with cardiopulmonary bypass, and cardiac surgery on the beating heart in the presence of comorbidities."
* #basis-0001-00662 "O'ng bo'lmachadan chiquvchi (elektrofiziologik tekshiruv va radiochastotali ablatsiya, elektrokardiostimulyator, kardioverter-defibrillyator va CRT-D implantatsiyasi)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Выходящий из правого желудочка (электрофизиологическое исследование и радиочастотная абляция, имплантация кардиостимулятора, кардиовертера-дефибриллятора и устройства для сердечной ресинхронизирующей терапии с дефибриллятором)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Originating from the right ventricle (electrophysiological study and radiofrequency ablation, implantation of pacemaker, cardioverter-defibrillator and cardiac resynchronization therapy defibrillator)"
* #basis-0001-00663 "Chap bo'lmachadan chiquvchi (elektrofiziologik tekshiruv va radiochastotali ablatsiya, elektrokardiostimulyator, kardioverter-defibrillyator va CRT-D implantatsiyasi)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Выходящий из левого желудочка (электрофизиологическое исследование и радиочастотная абляция, кардиостимулятор, кардиовертер-дефибриллятор и имплантация CRT-D)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Originating from the left ventricle (electrophysiological study and radiofrequency ablation, implantation of pacemaker, cardioverter-defibrillator and CRT-D)"
* #basis-0001-00664 "O'ng bo'lmachadan chiquvchi (yuqori texnologik elektrofiziologik tekshiruv va (yoki) radiochastotali ablatsiya (CARTO bilan yoki CARTO siz), krioablyatsiya (CARTO bilan yoki CARTO siz), elektrokardiostimulyator, kardioverter-defibrillyator va CRT-D implantatsiyasi)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Аритмии, исходящие из правого предсердия (высокотехнологичное электрофизиологическое исследование и (или) радиочастотная абляция (с CARTO или без CARTO), криоабляция (с CARTO или без CARTO), имплантация электрокардиостимулятора, кардиовертера-дефибриллятора и CRT-D)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Arrhythmias originating from the right atrium (high-tech electrophysiological study and/or radiofrequency ablation (with or without CARTO), cryoablation (with or without CARTO), implantation of pacemaker, cardioverter-defibrillator and CRT-D)"
* #basis-0001-00665 "Chap bo'lmachadan chiquvchi (Yuqori texnologik elektrofiziologik tekshiruv va (yoki) radiochastotali ablatsiya (CARTO bilan yoki CARTO siz), krioablyatsiya (CARTO bilan yoki CARTO siz), elektrokardiostimulyator, kardioverter-defibrillyator va CRT-D implantatsiyasi)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Аритмии, исходящие из левого предсердия (Высокотехнологичное электрофизиологическое исследование и (или) радиочастотная абляция (с CARTO или без CARTO), криоабляция (с CARTO или без CARTO), имплантация электрокардиостимулятора, кардиовертера-дефибриллятора и CRT-D)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Arrhythmias originating from the left atrium (high-tech electrophysiological study and/or radiofrequency ablation (with or without CARTO), cryoablation (with or without CARTO), implantation of pacemaker, cardioverter-defibrillator and CRT-D)"
