  * ^designation[+].language = #en
  * ^designation[=].value = "Acute respiratory failure"
* #basis-0001-01585 "Medikamentlardan oʻtkir zaharlanish (antibiotiklar, sulfanilamidlar, parazitlarga qarshi vositalar, gipoglikemik vositalar, drotaverin, eufillin, temir dori vositalari, tumovga qarshi vositalar, diuretiklar, miorelaksantlar va boshqalar )"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление лекарственными препаратами (антибиотики, сульфаниламиды, противопаразитарные средства, гипогликемические препараты, дротаверин, эуфиллин, препараты железа, жаропонижающие средства, диуретики, миорелаксанты и др.)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by drugs (antibiotics, sulfonamides, antiparasitic agents, hypoglycemic agents, drotaverine, aminophylline, iron preparations, antipyretics, diuretics, muscle relaxants, etc.)."
* #basis-0001-01586 "Narkotiklar, anestetiklar va psixodisleptiklardan (gallyutsinogenlar) oʻtkir zaharlanish (opiatlar, geroin, kokain, metadon, kannibiodlar va boshqalar)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление наркотиками, анестетиками и психодилептиками (галлюциногенами) (опиатами, героином, кокаином, метадоном, каннабиноидами и др.)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by narcotics, anesthetics and psychodysleptics (hallucinogens) (opiates, heroin, cocaine, methadone, cannabinoids, etc.)."
* #basis-0001-01587 "Tutqanoqga qarshi, sedativ, uxlatuvchi, parkinsonizmga karshi dori vositalaridan oʻtkir zaharlanishlar (trankvilizatorlar, iminostilbenlar, karbamazepin, qonvuleks, valproyevaya kislota, pregabalin, gabapentinoid va boshqalar)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление противосудорожными, седативными, снотворными и противопаркинсоническими препаратами (транквилизаторами, иминостильбенами, карбамазепином, канвулексом, вальпроевой кислотой, прегабалином, габапентиноидами и др.)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by antiepileptic, sedative-hypnotic and antiparkinsonism drugs (tranquilizers, iminostilbenes, carbamazepine, Convulex, valproic acid, pregabalin, gabapentinoids, etc.)."
* #basis-0001-01588 "Tritsiklik va tetratsiklik antidepressantlardan oʻtkir zaharlanish (amitriptilin, SIOZS, IOZSN, IMAO); antipsixotik va neyroleptik dori vositalaridan oʻtkir zaharlanish (antipsixotiklar, neyroleptiklar, psixodisleptiklar va ixtiyoriy-faol modda)."
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление трициклическими и тетрациклическими антидепрессантами (амитриптином, СИОЗС, ИООЗСН, ингибиторами МАО); острое отравление антипсихотическими и нейролептическими препаратами (антипсихотиками, нейролептиками, психодислептиками и веществами, обладающими волевой активностью)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by tricyclic and tetracyclic antidepressants (amitriptyline, SSRIs, SNRIs, MAO inhibitors); acute poisoning by antipsychotic and neuroleptic drugs (antipsychotics, neuroleptics, psychodysleptics and psychoactive substances)."
* #basis-0001-01589 "Alkogol surrogatlaridan oʻtkir zaharlanish (metil spirti, propil spirti, sivush yogʻi, etilenglikol )"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление заменителями алкоголя (метиловый спирт, пропиловый спирт, касторовое масло, этиленгликоль)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by alcohol substitutes (methanol, propanol, castor oil, ethylene glycol)"
* #basis-0001-01590 "Organik erituvchilar, neft maxsulotlari, galogen hosil qiluvchi uglevodorod vositalardan oʻtkir zaharlanish (benzin, kerosin, solyarka, benzol, 4 xlorli uglevodorod, xloroform, trixloretilen, tetraxloretilen, dixlormetan va boshqalar)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление органическими растворителями, нефтепродуктами, галогенообразующими углеводородами (бензин, керосин, дизельное топливо, бензол, тетрахлорэтилен, хлороформ, трихлорэтилен, тетрахлорэтилен, дихлорметан и др.)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by organic solvents, petroleum products, halogenated hydrocarbons (gasoline, kerosene, diesel fuel, benzene, tetrachloroethylene, chloroform, trichloroethylene, dichloromethane, etc.)."
* #basis-0001-01591 "Kuydiruvchi vositalardan oʻtkir zaharlanish (kislotalar — sirka kislotasi, xlorid kislota, sulfat kislotasi va boshqa kislotalar, ishqorlar, fenollar, oksidlovchilar, detergentlar)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление едкими веществами (кислотами — уксусной кислотой, соляной кислотой, серной кислотой и другими кислотами, щелочами, фенолами, окислителями, моющими средствами)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by corrosive substances (acids - acetic, hydrochloric, sulfuric and other acids, alkalis, phenols, oxidizers, detergents)."
* #basis-0001-01592 "Ogʻir metal tuzlaridan oʻtkir zaharlanish (qoʻrgʻoshin, simob, bariy va boshqa metallar)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление солями тяжелых металлов (свинца, ртути, бария и других металлов)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by heavy metal salts (lead, mercury, barium and other metals)"
* #basis-0001-01593 "Toksik gazlardan oʻtkir zaharlanish (is gazi, serovodorod, xlor gazi va boshqa gazlar)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление токсичными газами (оксидом углерода, сероводородом, хлором и другими газами)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by toxic gases (carbon monoxide, hydrogen sulfide, chlorine and other gases)"
* #basis-0001-01594 "Zaharli ximikatlardan oʻtkir zaharlanish (FOS, XOS, zookumarinlar)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление токсичными химическими веществами (ФОС, КСО, зоокумарины)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by toxic chemicals (organophosphorus compounds, organochlorine compounds, zoocoumarins)"
* #basis-0001-01595 "Oʻsimliklar zaharlaridan oʻtkir zaharlanish (bangidevona, chilibuxa, muskat yongʻogʻi va boshqa oʻsimliklar); (qoʻziqorinlaroq va boshqa qoʻziqorinlar)."
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление растительными ядами (банан, перец чили, мускатный орех и другие растения); (грибы и другие грибы)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by plant toxins (datura, henbane, nutmeg and other plants); (mushrooms and other fungi)."
* #basis-0001-01596 "Biologik zaharlardan oʻtkir zaharlanish (zaharli ilon chaqishi — gadyuka, shitomordnik, efa, kobra; qoraqurt)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление биологическими ядами (укусы ядовитых змей - гадюка, гадюка, змея, кобра; черная кобра)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by biological toxins (venomous snake bites - viper, gyurza, cobra, black cobra)"
* #basis-0001-01597 "Biologik zaharlardan oʻtkir zaharlanish (chayon chaqishi, ari va asal ari chaqishi va boshqa hasharotlar)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление биологическими ядами (укусы скорпионов, пчел и медоносных пчел, а также других насекомых)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by biological toxins (bites of scorpions, bees, wasps and other insects)."
* #basis-0001-01598 "Metgemoglobin hosil qiluvchi va nomaʼlum zaharlardan oʻtkir zaharlanish (selitra, anilin, sianidlar)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острое отравление метгемоглобинообразующими и неизвестными ядами (нитратами, анилином, цианидами)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute poisoning by methemoglobin-forming and unknown poisons (nitrates, aniline, cyanides)."
* #basis-0001-01599 "Yurak ishemik kasalligi, nostabil stenokardiya (birinchi marta paydo boʻlgan stenokardiya, avj olib boruvchi stenokardiya, infarktdan keyingi erta stenokardiya, operatsiyalardan keyingi stenokardiya, spontan stenokardiya) ST elevatsiyasiz oʻtkir koronar sindrom. Q tishchali va tishchasiz oʻtkir miokard infarkti, qaytalangan miokard infarkti, retsidiv miokard infarkti"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Ишемическая болезнь сердца, нестабильная стенокардия (первичная стенокардия, стенокардия обострения, ранняя постинфарктная стенокардия, послеоперационная стенокардия, спонтанная стенокардия), острый коронарный синдром без подъема сегмента ST. Острый инфаркт миокарда с зубцом Q и без него, рецидивирующий инфаркт миокарда, повторный инфаркт миокарда."
  * ^designation[+].language = #en
  * ^designation[=].value = "Coronary heart disease, unstable angina (new-onset angina, crescendo angina, early post-infarction angina, postoperative angina, spontaneous angina), non-ST-elevation acute coronary syndrome. Acute Q-wave and non-Q-wave myocardial infarction, recurrent myocardial infarction, repeat myocardial infarction."
* #basis-0001-01600 "ST elevatsiyali oʻtkir koronar sindrom"
  * ^designation[0].language = #ru
  * ^designation[=].value = "острый коронарный синдром с подъемом сегмента ST"
  * ^designation[+].language = #en
  * ^designation[=].value = "ST-elevation acute coronary syndrome"
* #basis-0001-01601 "Yurak ritmining buzilishi Qorinchalar ekstrasistoliyasi (yuqori gradatsiyali Lown boʻyicha III-V sinflar)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Сердечные аритмии, желудочковая экстрасистолия (высокая степень по классификации Лоуна III-V классов)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Cardiac arrhythmias, ventricular extrasystole (high grade, Lown class III-V)."
* #basis-0001-01602 "Yurak oʻtkazuvchanligining buzilishi (sinoatrikulyar, atrioventrikulyar blokadalar ( Morganye-Adams-Stoks sindromi I, II, III darajadagi AV blokadalar), Giss tutami chap oyoqchasining blokadalari"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Нарушения сердечной проводимости (синоатриальные, атриовентрикулярные блокады (синдром Морганье-Адамса-Стокса, атриовентрикулярные блокады I, II, III степеней), блокада левой ветви пучка Гиса)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Cardiac conduction disorders (sinoatrial, atrioventricular blocks (Morgagni-Adams-Stokes syndrome, first-, second-, third-degree AV block), left bundle branch block)"
* #basis-0001-01603 "Oʻtkir yurak yetishmovchiligi; surunkali yurak yetishmovchiligi xuruj davri."
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острая сердечная недостаточность; обострение хронической сердечной недостаточности."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute heart failure; exacerbation of chronic heart failure."
* #basis-0001-01604 "Kardiomiopatiyalar: Dilatatsion (DKMP); Gipertrofik (GKMP); Restriktiv (RKMP)."
  * ^designation[0].language = #ru
  * ^designation[=].value = "Кардиомиопатии: дилатационная (ДКМП); гипертрофическая (ГКМП); рестриктивная (РКМП)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Cardiomyopathies: dilated (DCM); hypertrophic (HCM); restrictive (RCM)."
