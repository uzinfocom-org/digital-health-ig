  * ^designation[=].value = "Тяжелая железодефицитная анемия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Severe iron deficiency anemia"
* #basis-0001-01609 "Oʻtkir appenditsit (asoratlanmagan); oʻtkir appenditsit (appendikulyar abssess, qorin boʻshligʻi abssesslari); appendikulyar infiltrat."
  * ^designation[0].language = #ru
  * ^designation[=].value = "Острый аппендицит (неосложненный); острый аппендицит (абсцесс аппендикса, абсцесс брюшной полости); инфильтрат в аппендиксе."
  * ^designation[+].language = #en
  * ^designation[=].value = "Acute appendicitis (uncomplicated); acute appendicitis (appendiceal abscess, abdominal abscess); appendiceal infiltrate."
* #basis-0001-01610 "Qisilgan churralar-chov (qiyshiq, toʻgʻri), son kindik va qorinning oq chizigʻi churralari; kindik va qorin old devori churralari, operatsiyadan keyingi qorin old devori (ventral) churralari"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Ущемленные грыжи — паховые (косые, прямые), бедренно-пупочные и паховые грыжи; пупочные грыжи и грыжи передней брюшной стенки, послеоперационные грыжи передней брюшной стенки (вентральные)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Incarcerated hernias - inguinal (indirect, direct), femoral and inguinal hernias; umbilical and anterior abdominal wall hernias, postoperative ventral hernias."
