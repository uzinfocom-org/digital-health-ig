CodeSystem: ServiceRequestBasisCS
Id: service-request-basis-cs
Title: "Service Request Basis"
Description: "Service request basis codes in Uzbekistan"
* insert OriginalCodeSystemDraft(service-request-basis-cs)
* #basis-0001-00001 "Buyrakning yagona toshi (asoratsiz kechishi)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Одиночный камень почки (неосложнённое течение)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Solitary kidney stone (uncomplicated course)"
* #basis-0001-00002 "Kasallikning asoratlanishi yoki jarrohlik yo'li bilan davolanish uchun"
  * ^designation[0].language = #ru
  * ^designation[=].value = "При осложнениях заболевания или для хирургического лечения"
  * ^designation[+].language = #en
  * ^designation[=].value = "In case of disease complications or for surgical treatment"
* #basis-0001-00003 "Ko'p sonli va marjonsimon buyrak toshlari jarrohlik yo'li bilan davolanish uchun. Kasallik asoratlarini qaytalanishi yoki ikkilamchi jarrohlik amaliyotini bajarish uchun"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Для хирургического лечения множественных и коралловидных камней в почках. При рецидиве осложнений заболевания или для проведения повторной операции."
  * ^designation[+].language = #en
  * ^designation[=].value = "For surgical treatment of multiple and staghorn kidney stones. In case of recurrent disease complications or for repeat surgery."
* #basis-0001-00004 "Kasallik asoratlarini qaytalanishi yoki ikkilamchi jarrohlik amaliyotini bajarish uchun"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Для предотвращения рецидива осложнений заболевания или для проведения повторной операции."
  * ^designation[+].language = #en
  * ^designation[=].value = "To prevent recurrence of disease complications or for repeat surgery."
* #basis-0001-00005 "5 mm dan kichik siydik nayi toshlari"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Камни мочеточника размером менее 5 мм"
  * ^designation[+].language = #en
  * ^designation[=].value = "Ureteral stones smaller than 5 mm"
