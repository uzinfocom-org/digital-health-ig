  * ^designation[=].value = "Заболевание представляет собой тяжелый нефритический или нефротический синдром (протеинурия ≥3,3 г/л), тяжелое артериальное давление (≥160/100 мм.е.), в стероидорезистентных случаях, при подозрении на нарушение функции почек и осложнении нефротического криза, при развитии сердечной недостаточности на фоне артериальной гипертензии."
  * ^designation[+].language = #en
  * ^designation[=].value = "Disease with severe nephritic or nephrotic syndrome (proteinuria ≥3.3 g/L), severe arterial hypertension (≥160/100 mmHg), steroid-resistant cases, suspected renal impairment and nephrotic crisis complications, heart failure secondary to arterial hypertension."
