  * ^designation[=].value = "For conservative treatment and surgical intervention"
* #basis-0001-02804 "Jarrohlik amaliyoti uchun (qo‘shimcha yondosh va/yoki raqobatdosh surunkali kasalliklari hamda asoratlanganda)"
