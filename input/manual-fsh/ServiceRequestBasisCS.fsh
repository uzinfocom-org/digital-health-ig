  * ^designation[0].language = #ru
  * ^designation[=].value = "Врожденная диафрагмальная грыжа"
  * ^designation[+].language = #en
  * ^designation[=].value = "Congenital diaphragmatic hernia"
* #basis-0001-03287 "Diafragmaning boshqa rivojlanish nuqsonlari"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Другие пороки развития диафрагмы"
  * ^designation[+].language = #en
  * ^designation[=].value = "Other congenital malformations of diaphragm"
* #basis-0001-03288 "Ekzomfaloz"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Экзомфалез"
  * ^designation[+].language = #en
  * ^designation[=].value = "Exomphalos"
* #basis-0001-03289 "Gastroshiz"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Гастроз"
  * ^designation[+].language = #en
  * ^designation[=].value = "Gastroschisis"
* #basis-0001-03290 "Odatlanilgan bola tashlashga ega ayollarga tibbiy yordam ko‘rsatish. Bachadon ichi muolajalarini talab qiluvchi (amniotsentez, kordotsentez, homiladorlik davrida homilaga qon quyish amaliyoti, homiladorlik davrida homilaning qorin bo‘shlig‘iga qon quyish amaliyoti) odatga aylangan homiladorlikni yo‘qotish bilan asoratlangan rezus-immunizatsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Медицинская помощь женщинам с привычным невынашиванием беременности. Резус-иммунизация, осложненная привычным невынашиванием беременности, требующая внутриматочных процедур (амниоцентез, кордоцентез, переливание крови плода во время беременности, внутрибрюшное переливание крови плода во время беременности)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Medical care for women with recurrent pregnancy loss. Rh immunization complicated by recurrent pregnancy loss requiring intrauterine procedures (amniocentesis, cordocentesis, intrauterine fetal blood transfusion, intraperitoneal fetal blood transfusion)"
* #basis-0001-03291 "Homilada markaziy asab tizimining malformatsiyasi, onaga tibbiy yordam ko‘rsatishni talab qiladi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Пороки развития центральной нервной системы у плода требуют медицинской помощи матери"
  * ^designation[+].language = #en
  * ^designation[=].value = "Central nervous system malformation in fetus requiring maternal care"
* #basis-0001-03292 "Homiladagi xromosoma anomaliyalari (taxmin qilingan), onaga tibbiy yordam ko‘rsatishni talab qiladi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Хромосомные аномалии плода (предположительно), требующие материнской заботы"
  * ^designation[+].language = #en
  * ^designation[=].value = "Chromosomal abnormality in fetus (suspected) requiring maternal care"
* #basis-0001-03293 "Homilada irsiy kasalliklar (taxmin qilingan), onaga tibbiy yordam ko‘rsatishni talab qiladi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Наследственные нарушения у плода (предположительно), требующие медицинской помощи матери"
  * ^designation[+].language = #en
  * ^designation[=].value = "Hereditary disease in fetus (suspected) requiring maternal care"
* #basis-0001-03294 "Onaning virusli kasalligi natijasida homila shikastlanishi (taxmin qilingan), bu onaga tibbiy yordam ko‘rsatishni talab qiladi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Травма плода (предположительно) в результате вирусного заболевания матери, требующего медицинской помощи матери"
  * ^designation[+].language = #en
  * ^designation[=].value = "Damage to fetus (suspected) from maternal viral disease requiring maternal care"
* #basis-0001-03295 "Onaga tibbiy yordam ko‘rsatishni talab qiluvchi homilaning (taxmin qilingan) boshqa anomaliyalari va shikastlanishlari. Kam invaziv bachadon ichi fetal jarrohlik muolajalarini talab qiluvchi homila vodyankasi (assit, gidrotoraks, xilotoraks), antenal punksion va drenaj davo usullarini talab qiluvchi homilaning tug‘ma nuqsonlari (buyrak gidronefrozi, gidrotsefaliya, orqa uretra klapani) — homilada amniotsentez, laparotsentez, torakotsentez bajarilishi, torakoamnial, nefroamnial, vezikoamnial shuntlash amaliyotlari."
  * ^designation[0].language = #ru
  * ^designation[=].value = "Другие (предполагаемые) аномалии и травмы плода, требующие медицинской помощи матери. Асцит плода (асцит, гидроторакс, хилоторакс), требующий малоинвазивных внутриутробных хирургических вмешательств у плода, врожденные пороки развития плода, требующие усиковой пункции и дренирующих методов (гидронефроз почки, гидроцефалия, клапан задней уретры) — амниоцентез, лапароцентез, торакоцентез, торакоамниальное, нефроамниальное, пузырно-амниальное шунтирование."
  * ^designation[+].language = #en
  * ^designation[=].value = "Other (suspected) fetal abnormality and damage requiring maternal care. Fetal hydrops (ascites, hydrothorax, chylothorax) requiring minimally invasive intrauterine fetal surgery; congenital fetal malformations requiring fetal puncture and drainage (hydronephrosis, hydrocephalus, posterior urethral valve) - amniocentesis, laparocentesis, thoracocentesis, thoracoamniotic, nephroamniotic, vesicoamniotic shunting."
* #basis-0001-03296 "Onaga tibbiy yordam ko‘rsatishni talab qiluvchi, homilaning aniqlanmagan anomaliyasi va shikastlanishi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Неуточненные аномалии и травмы плода, требующие медицинской помощи матери."
  * ^designation[+].language = #en
  * ^designation[=].value = "Fetal abnormality and damage, unspecified, requiring maternal care."
* #basis-0001-03297 "Onaga tibbiy yordam ko‘rsatishni talab qiluvchi, rezus-immunizatsiya. Fetal jarrohlik amaliyotlari (amniotsentez, kordotsentez, homiladorlik davrida homilaga qon quyish amaliyoti, homiladorlik davrida homilaning qorin bo‘shlig‘iga qon quyish amaliyoti)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Резус-иммунизация, требующая медицинской помощи матери. Хирургия плода (амниоцентез, кордоцентез, переливание крови плода во время беременности, переливание крови плода в брюшную полость во время беременности)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Rh isoimmunization requiring maternal care. Fetal surgery (amniocentesis, cordocentesis, intrauterine fetal blood transfusion, intraperitoneal fetal blood transfusion)"
* #basis-0001-03298 "Onaga tibbiy yordam ko‘rsatishni talab qiluvchi, izoimmunizatsiyaning boshqa turlari"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Другие виды изоиммунизации, требующие медицинской помощи матери"
  * ^designation[+].language = #en
  * ^designation[=].value = "Other isoimmunization requiring maternal care"
* #basis-0001-03299 "Onaga tibbiy yordam ko‘rsatishni talab qiluvchi, homilaning yetarli darajada o‘smasligi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Недостаточный рост плода, требующий медицинской помощи матери."
  * ^designation[+].language = #en
  * ^designation[=].value = "Poor fetal growth requiring maternal care."
* #basis-0001-03300 "Onaga tibbiy yordam ko‘rsatishni talab qiluvchi, homila holatidagi boshqa aniqlangan chetga chiqishlar. Kam invaziv bachadon ichi fetal jarrohlik muolajalarini talab qiluvchi homila vodyankasi (assit, gidrotoraks) (homilada amniotsentez, laparotsentez, torakotsentez bajarilishi). Antenal punksion va drenaj davo usullarini talab qiluvchi homilaning tug‘ma nuqsonlari (buyrak gidronefrozi, gidrotsefaliya, orqa uretra klapani)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Другие выявленные отклонения в положении плода, требующие медицинской помощи матери. Отеки плода (асцит, гидроторакс), требующие малоинвазивных внутриутробных хирургических вмешательств у плода (амниоцентез, лапароцентез, торакоцентез у плода). Врожденные пороки развития плода (гидронефроз почки, гидроцефалия, клапан задней уретры), требующие усико-пункционных и дренирующих методов лечения."
  * ^designation[+].language = #en
  * ^designation[=].value = "Other specified fetal problems requiring maternal care. Fetal hydrops (ascites, hydrothorax) requiring minimally invasive intrauterine fetal surgery (fetal amniocentesis, laparocentesis, thoracocentesis). Congenital fetal malformations (hydronephrosis, hydrocephalus, posterior urethral valve) requiring fetal puncture and drainage treatment."
* #basis-0001-03301 "Ko‘p suvlilik (poligidroamnion). Kam invaziv bachadon ichi fetal jarrohlik muolajalarini talab qiluvchi ko‘p suvlilik (amnioreduksiya). Antenal punksion va drenaj davo usullarini talab qiluvchi homilaning tug‘ma nuqsonlari (buyrak gidronefrozi, gidrotsefaliya, orqa uretra klapani)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Многоводие (многоводие). Многоводие (амниоредукция), требующее минимально инвазивных внутриутробных хирургических вмешательств у плода. Врожденные пороки развития плода (гидронефроз почки, гидроцефалия, клапан задней уретры), требующие усико-пункционных и дренирующих методов лечения."
  * ^designation[+].language = #en
  * ^designation[=].value = "Polyhydramnios. Polyhydramnios (amnioreduction) requiring minimally invasive intrauterine fetal surgery. Congenital fetal malformations (hydronephrosis, hydrocephalus, posterior urethral valve) requiring fetal puncture and drainage treatment."
* #basis-0001-03302 "Platsentar transfuziya sindromi. Bachadon ichi muolajalarini talab qiluvchi yo‘ldoshda patologiyalarni korreksiyasi (feto-fetal transfuzion sindromi, kopchiko-krestsovaya terratoma, xorionangioma) anastamozlarni lazer koagulyatsiya qilish"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Синдром плацентарной трансфузии. Коррекция патологий в плаценте, требующих внутриматочных процедур (синдром фето-фетальной трансфузии, копчико-крестцовая тератома, хорионангиома), лазерная коагуляция анастамозов"
  * ^designation[+].language = #en
  * ^designation[=].value = "Placental transfusion syndromes. Correction of placental pathologies requiring intrauterine procedures (twin-to-twin transfusion syndrome, sacrococcygeal teratoma, chorioangioma), laser coagulation of anastomoses"
* #basis-0001-03303 "Homila va chaqaloq gemolitik kasalligi. Bachadon ichi muolajalarini talab qiluvchi (amniotsentez, kordotsentez, homiladorlik davrida homilaga qon quyish amaliyoti, homiladorlik davrida homilaning qorin bo‘shlig‘iga qon quyish amaliyoti) odatga aylangan homiladorlikni yo‘qotish bilan asoratlangan rezus-immunizatsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Гемолитическая болезнь плода и младенца. Резус-иммунизация, осложненная привычным невынашиванием беременности, требующая внутриматочных процедур (амниоцентез, кордоцентез, переливание крови плода во время беременности, внутрибрюшное переливание крови плода во время беременности)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Hemolytic disease of fetus and newborn. Rh immunization complicated by recurrent pregnancy loss requiring intrauterine procedures (amniocentesis, cordocentesis, intrauterine fetal blood transfusion, intraperitoneal fetal blood transfusion)"
* #basis-0001-03304 "Homila va chaqaloqning AV0-izoimmunizatsiyasi. Bachadon ichi muolajalarini talab qiluvchi (amniotsentez, kordotsentez, homiladorlik davrida homilaga qon quyish amaliyoti, homiladorlik davrida homilaning qorin bo‘shlig‘iga qon quyish amaliyoti) odatga aylangan homiladorlikni yo‘qotish bilan asoratlangan rezus-immunizatsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "AV0-изоиммунизация плода и младенца. Резус-иммунизация, осложненная привычным невынашиванием беременности, требующая внутриматочных процедур (амниоцентез, кордоцентез, переливание крови плода во время беременности, внутрибрюшное переливание крови плода во время беременности)"
  * ^designation[+].language = #en
  * ^designation[=].value = "ABO isoimmunization of fetus and newborn. Rh immunization complicated by recurrent pregnancy loss requiring intrauterine procedures (amniocentesis, cordocentesis, intrauterine fetal blood transfusion, intraperitoneal fetal blood transfusion)"
* #basis-0001-03305 "Homila va chaqaloqning boshqa tur gemolitik kasalligi. Bachadon ichi muolajalarini talab qiluvchi (amniotsentez, kordotsentez, homiladorlik davrida homilaga qon quyish amaliyoti, homiladorlik davrida homilaning qorin bo‘shlig‘iga qon quyish amaliyoti) odatga aylangan homiladorlikni yo‘qotish bilan asoratlangan rezus-immunizatsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Другой тип гемолитической болезни плода и младенца. Резус-иммунизация, осложненная привычным невынашиванием беременности, требующая внутриматочных процедур (амниоцентез, кордоцентез, переливание крови плода во время беременности, внутрибрюшное переливание крови плода во время беременности)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Other hemolytic diseases of fetus and newborn. Rh immunization complicated by recurrent pregnancy loss requiring intrauterine procedures (amniocentesis, cordocentesis, intrauterine fetal blood transfusion, intraperitoneal fetal blood transfusion)"
* #basis-0001-03306 "Aniqlanmagan homila va chaqaloqning gemolitik kasalligi. Bachadon ichi muolajalarini talab qiluvchi (amniotsentez, kordotsentez, homiladorlik davrida homilaga qon quyish amaliyoti, homiladorlik davrida homilaning qorin bo‘shlig‘iga qon quyish amaliyoti) odatga aylangan homiladorlikni yo‘qotish bilan asoratlangan rezus-immunizatsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Гемолитическая болезнь плода и новорожденного неуточненная. Резус-иммунизация, осложненная привычным невынашиванием беременности, требующая внутриматочных процедур (амниоцентез, кордоцентез, переливание крови плода во время беременности, внутрибрюшное переливание крови плода во время беременности)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Hemolytic disease of fetus and newborn, unspecified. Rh immunization complicated by recurrent pregnancy loss requiring intrauterine procedures (amniocentesis, cordocentesis, intrauterine fetal blood transfusion, intraperitoneal fetal blood transfusion)"
* #basis-0001-03307 "Izoimmunizatsiya sababli kelib chiqqan homila istisqosi. Bachadon ichi muolajalarini talab qiluvchi (amniotsentez, kordotsentez, homiladorlik davrida homilaga qon quyish amaliyoti, homiladorlik davrida homilaning qorin bo‘shlig‘iga qon quyish amaliyoti) odatga aylangan homiladorlikni yo‘qotish bilan asoratlangan rezus-immunizatsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Аборт плода вследствие изоиммунизации. Резус-иммунизация, осложненная привычным невынашиванием беременности, требующая внутриматочных процедур (амниоцентез, кордоцентез, переливание крови плода во время беременности, внутрибрюшное переливание крови плода во время беременности)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Hydrops fetalis due to isoimmunization. Rh immunization complicated by recurrent pregnancy loss requiring intrauterine procedures (amniocentesis, cordocentesis, intrauterine fetal blood transfusion, intraperitoneal fetal blood transfusion)"
* #basis-0001-03308 "Boshqa va aniqlanmagan gemolitik kasallik sababli kelib chiqqan homila istisqosi. Bachadon ichi muolajalarini talab qiluvchi (amniotsentez, kordotsentez, homiladorlik davrida homilaga qon quyish amaliyoti, homiladorlik davrida homilaning qorin bo‘shlig‘iga qon quyish amaliyoti) odatga aylangan homiladorlikni yo‘qotish bilan asoratlangan rezus-immunizatsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Аборт плода вследствие другого и неуточненного гемолитического заболевания. Резус-иммунизация, осложненная привычным невынашиванием беременности, требующая внутриматочных процедур (амниоцентез, кордоцентез, переливание крови плода во время беременности, внутрибрюшное переливание крови плода во время беременности)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Hydrops fetalis due to other and unspecified hemolytic disease. Rh immunization complicated by recurrent pregnancy loss requiring intrauterine procedures (amniocentesis, cordocentesis, intrauterine fetal blood transfusion, intraperitoneal fetal blood transfusion)"
* #basis-0001-03309 "Platsentaning boshqa va aniqlanmagan morfologik hamda funksional anomaliyalari natijasida kelib chiqqan homila va chaqaloqning shikastlanishlari. 2-3 darajali yo‘ldosh yetishmovchiligi bilan asoratlangan homilaning o‘sishini cheklanish sindromi (ultratovush tekshiruvi va dopplerografik usullari orqali tasdiqlangan), immunologik, endokrin, infeksion va elektrokardiostimulyatortragenital kasallik omillari bilan izohlanuvchi; konservativ davo muolajalar o‘tkazilishida zaruriyat bor holatlarda (shu jumladan bachadon ichi muolajalarini o‘tkazilishi amniotsentez, kordotsentez)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Травмы плода и ребенка, вызванные другими и неуточненными морфологическими и функциональными аномалиями плаценты. Синдром задержки роста плода, осложненный плацентарной недостаточностью 2-3 степени (подтвержденный ультразвуковым исследованием и допплерографическими методами), объясняемый иммунологическими, эндокринными, инфекционными и электрокардиограммами трагенитальных факторов заболевания; в случаях, когда необходимы консервативные методы лечения (в т.ч. внутриматочные процедуры, амниоцентез, кордоцентез)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Fetus and newborn affected by other and unspecified morphological and functional abnormalities of placenta. Fetal growth restriction complicated by placental insufficiency grade 2-3 (confirmed by ultrasound and Doppler), due to immunological, endocrine, infectious and extragenital factors; when conservative treatment is required (including intrauterine procedures, amniocentesis, cordocentesis)"
* #basis-0001-03310 "Homilaning gestatsion yosh uchun «kam vaznli»ligi 2-3 darajali yo‘ldosh yetishmovchiligi bilan asoratlangan homilaning o‘sishini cheklanish sindromi (ultratovush tekshiruvi va dopplerografik usullari orqali tasdiqlangan), immunologik, endokrin, infeksion va elektrokardiostimulyatortragenital kasallik omillari bilan izohlanuvchi; konservativ davo muolajalar o‘tkazilishida zaruriyat bor holatlarda (shu jumladan bachadon ichi muolajalarini o‘tkazilishi amniotsentez, kordotsentez)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "«Малый вес» плода для гестационного возраста объясняется синдромом задержки роста плода, осложненным плацентарной недостаточностью 2-3 степени (подтвержденной ультразвуковым исследованием и допплерографическими методами), иммунологическими, эндокринными, инфекционными и электрокардиограммами трагенитальных факторов заболевания; в случаях, когда необходимы консервативные методы лечения (в т.ч. внутриматочные процедуры, амниоцентез, кордоцентез)"
  * ^designation[+].language = #en
  * ^designation[=].value = "\"Light for gestational age\" fetus due to fetal growth restriction complicated by placental insufficiency grade 2-3 (confirmed by ultrasound and Doppler), immunological, endocrine, infectious and extragenital factors; when conservative treatment is required (including intrauterine procedures, amniocentesis, cordocentesis)"
* #basis-0001-03311 "Izoimmunizatsiya bilan bog‘liq bo‘lmagan homila istisqosi. Bachadon ichi muolajalarini talab qiluvchi (amniotsentez, kordotsentez, homiladorlik davrida homilaga qon quyish amaliyoti, homiladorlik davrida homilaning qorin bo‘shlig‘iga qon quyish amaliyoti). Noimmun homila shishi (assit yoki gidrotoraks yoki gidroperikard)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Аборт плода, не связанный с изоиммунизацией. Требуют внутриутробных процедур (амниоцентез, кордоцентез, переливание крови плоду при беременности, переливание крови в брюшную полость плода при беременности). Неиммунная опухоль плода (асцит, гидроторакс или гидроперикард)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Hydrops fetalis not due to isoimmunization. Requiring intrauterine procedures (amniocentesis, cordocentesis, intrauterine fetal blood transfusion, intraperitoneal fetal blood transfusion). Nonimmune fetal hydrops (ascites, hydrothorax or hydropericardium)"
* #basis-0001-03312 "Homilaning spina bifidasi. Bachadon ichi muolajalarini talab qiluvchi (spina bifida ochiq va yopiq usulda korreksiyasi)"
  * ^designation[0].language = #ru
