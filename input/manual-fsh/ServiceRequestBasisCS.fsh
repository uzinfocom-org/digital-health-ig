  * ^designation[=].value = "Для всех операций на сердце с несколькими клапанами"
  * ^designation[+].language = #en
  * ^designation[=].value = "For any heart surgery involving multiple valves"
* #basis-0001-00647 "Qorinchalararo to'siq nuqsoni, agar surunkali yurak yetishmovchiligining II va III bosqichi, funksional sinfi III va IV rivojlangan bo'lsa, konservativ davo uchun"
  * ^designation[0].language = #ru
  * ^designation[=].value = "При наличии дефекта межжелудочковой перегородки, если хроническая сердечная недостаточность II и III стадии, функционального класса III и IV, показан консервативный подход к лечению."
  * ^designation[+].language = #en
  * ^designation[=].value = "Ventricular septal defect; conservative treatment is indicated if chronic heart failure stage II-III, functional class III-IV has developed."
* #basis-0001-00648 "Bo'lmacha-qorincha oraliq to'siq nuqsoni agar surunkali yurak yetishmovchiligining II va III bosqichi, funksional sinfi III va IV rivojlangan bo'lsa, konservativ davo uchun"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Дефект межжелудочковой перегородки — это состояние, при котором консервативное лечение нецелесообразно, если развилась хроническая сердечная недостаточность II и III стадий, функционального класса III и IV."
  * ^designation[+].language = #en
  * ^designation[=].value = "Ventricular septal defect; conservative treatment if chronic heart failure stage II-III, functional class III-IV has developed."
* #basis-0001-00649 "Aorta va o'pka arteriyasi oraliq to'siq nuqsoni agar surunkali yurak yetishmovchiligining II va III bosqichi, funksional sinfi III va IV rivojlangan bo'lsa, konservativ davo uchun"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Дефект межпредсердной перегородки аорты и легочной артерии — это состояние, при котором консервативное лечение нецелесообразно, если развилась хроническая сердечная недостаточность II и III стадий, функционального класса III и IV."
  * ^designation[+].language = #en
  * ^designation[=].value = "Aortopulmonary septal defect; conservative treatment if chronic heart failure stage II-III, functional class III-IV has developed."
* #basis-0001-00650 "Yurak to'siqlarining boshqa tug'ma anomaliyalari agar surunkali yurak yetishmovchiligining II va III bosqichi, funksional sinfi III va IV rivojlangan bo'lsa, konservativ davo uchun"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Другие врожденные аномалии сердечных клапанов рассматриваются для консервативного лечения, если развилась хроническая сердечная недостаточность II и III стадий, функционального класса III и IV."
  * ^designation[+].language = #en
  * ^designation[=].value = "Other congenital malformations of cardiac valves; conservative treatment if chronic heart failure stage II-III, functional class III-IV has developed."
* #basis-0001-00651 "Kasallik bosqichidan kat'iy nazar, barcha simptomatik va umumiy quvvatlantiruvchi hamda xirurgik davo"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Независимо от стадии заболевания, предоставляются все виды симптоматического, общего поддерживающего и хирургического лечения."
  * ^designation[+].language = #en
  * ^designation[=].value = "Regardless of disease stage, all types of symptomatic, general supportive and surgical treatment are provided."
* #basis-0001-00652 "Kasallik bosqichidan kat'iy nazar, barcha simptomatik va umumiy quvvatlantiruvchi hamda shu jumladan kaminvaziv va kombinirlangan xirurgik davo (yondosh kasalliklari mavjud bemorlarda)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Вне зависимости от стадии заболевания проводится все виды симптоматического и общего укрепления, включая малоинвазивное и комбинированное хирургическое лечение (у пациентов с сопутствующими заболеваниями)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Regardless of disease stage, all types of symptomatic and general supportive treatment, including minimally invasive and combined surgical treatment (in patients with comorbidities)."
* #basis-0001-00653 "Kasallik bosqichidan kat'iy nazar, barcha simptomatik va umumiy quvvatlantiruvchi hamda xirurgik davo (yondosh kasalliklari mavjud bemorlarda)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Вне зависимости от стадии заболевания, проводится все виды симптоматического, общего укрепляющего и хирургического лечения (у пациентов с сопутствующими заболеваниями)."
  * ^designation[+].language = #en
  * ^designation[=].value = "Regardless of disease stage, all types of symptomatic, general supportive and surgical treatment (in patients with comorbidities)."
* #basis-0001-00654 "Ballon angioplastikasi va stentlash amaliyoti"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Баллонная ангиопластика и стентирование"
  * ^designation[+].language = #en
  * ^designation[=].value = "Balloon angioplasty and stenting"
* #basis-0001-00655 "Cimptomatik va umumiy quvvatlantiruvchi konservativ davo"
