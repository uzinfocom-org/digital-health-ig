  * ^designation[+].language = #en
  * ^designation[=].value = "Transsphincteric and extrasphincteric fistulas, grade III-IV"
* #basis-0001-00980 "To'g'ri ichak oqmalari transfinkter va intrasfinkter Oqmalari. Oqma yo'lini bartaraf etish operatsiyalari barcha turlari"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Ректальные свищи. Трансфинктерные и интрафинктерные свищи. Все виды операций по удалению свищей."
  * ^designation[+].language = #en
  * ^designation[=].value = "Rectal fistulas. Transsphincteric and intrasphincteric fistulas. All types of fistula surgery."
* #basis-0001-00981 "To'g'ri ichak oqmalari ekstrasfinkter, transfinkter va intrasfinkter oqmalari. Qo'shimcha yondosh kasalliklari mavjudligi. Oqma yo'lini bartaraf etish operatsiyalari barcha turlari"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Ректальные свищи: экстрасфинктерные, трансфинктерные и интрасфинктерные. Наличие сопутствующих заболеваний. Все виды операций по устранению свищей."
  * ^designation[+].language = #en
