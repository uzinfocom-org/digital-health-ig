  * ^designation[+].language = #en
  * ^designation[=].value = "Congenital torticollis. In severe forms of the disease or repeat surgery."
* #basis-0001-01758 "Oyoqlar o‘qi deformatsiyalari. Tashxislash, konservativ, operativ davo"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Деформации оси ног. Диагностика, консервативное, оперативное лечение"
