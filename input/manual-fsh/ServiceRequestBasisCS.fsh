  * ^designation[+].language = #en
  * ^designation[=].value = "Primary disease, induction stage, consolidation stage and relapse stage. Patient at the stage of bone marrow transplantation and postoperative rehabilitation."
* #basis-0001-00760 "Birlamchi kasallikga gumon bo'lganda. Birlamchi essentsial trombotsitemiya (1,2,3 boskichlari) va o'tkir leykozga transformatsiyasi, terminal va palliativ bosqichlarida"
  * ^designation[0].language = #ru
