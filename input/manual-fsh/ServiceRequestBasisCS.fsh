* #basis-0001-01751 "Son tug‘ma deformatsiyalari. Son suyagi tug‘ma chiqishini tana tortimi tizimida davolash, konservativ, operativ davo maqsadida"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Врожденные деформации бедра. Лечение врождённого вывиха бедра методом вытяжения, консервативное и оперативное лечение"
  * ^designation[+].language = #en
  * ^designation[=].value = "Congenital deformities of hip. Treatment of congenital hip dislocation by traction, conservative and surgical treatment"
* #basis-0001-01752 "Son tug‘ma deformatsiyalari. Og‘ir (og‘ir displaziya) son suyagi tug‘ma chiqishini tana tortimida davolash va jarrohlik usulida davolash"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Врожденные деформации бедра. Лечение тяжёлого врождённого вывиха бедра (тяжёлая дисплазия) методом вытяжения и хирургическим способом"
  * ^designation[+].language = #en
  * ^designation[=].value = "Congenital deformities of hip. Treatment of severe congenital hip dislocation (severe dysplasia) by traction and surgery"
