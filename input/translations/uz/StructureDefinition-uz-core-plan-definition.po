# Text that can be used to describe the constraint in messages identifying that the constraint has been violated.
#: StructureDefinition.element.PlanDefinition/constraint
msgid "A schedule must declare exactly one focus useContext, so clients can tell what kind of schedule it is"
msgstr "Jadval aniq bitta focus foydalanish kontekstini ko'rsatishi shart, shunda mijozlar jadval turini aniqlay oladi"

# Text that can be used to describe the constraint in messages identifying that the constraint has been violated.
#: StructureDefinition.element.PlanDefinition/constraint
msgid "A schedule is either national or regional: a jurisdiction of Uzbekistan as a whole cannot be combined with individual regions"
msgstr "Jadval yo milliy, yo hududiy bo'ladi: butun O'zbekiston yurisdiksiyasini alohida viloyatlar bilan birga ko'rsatib bo'lmaydi"

