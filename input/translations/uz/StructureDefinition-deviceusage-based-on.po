# A short, descriptive, user-friendly title for the structure definition.
#: StructureDefinition.title
msgid "Based On Device Request"
msgstr "Asos - buyum so'rovi"

# A free text natural language description of the structure definition from a consumer's perspective.
#: StructureDefinition.description
msgid "A device request that is fulfilled in whole or in part by this device usage."
msgstr "Buyumdan bu foydalanish to'liq yoki qisman bajaradigan buyum so'rovi."

# Explanation of why this structure definition is needed and why it has been designed as it has.
#: StructureDefinition.purpose
msgid "FHIR R5 DeviceUsage.basedOn allows only ServiceRequest, and the standard event-basedOn extension has no DeviceUsage context. FHIR-59962 asks HL7 to allow DeviceRequest in DeviceUsage.basedOn. This extension will be retired when that change is published."
msgstr "FHIR R5 da DeviceUsage.basedOn faqat ServiceRequest ga ruxsat beradi, standart event-basedOn kengaytmasida esa DeviceUsage konteksti yo'q. FHIR-59962 HL7 dan DeviceUsage.basedOn da DeviceRequest ga ruxsat berishni so'raydi. Bu o'zgarish nashr etilganda ushbu kengaytma bekor qilinadi."

# A concise description of what this element means (e.g. for use in autogenerated summaries).
#: StructureDefinition.element.Extension/short
msgid "Fulfilled device request"
msgstr "Bajarilayotgan buyum so'rovi"

# Provides a complete explanation of the meaning of the data element for human readability.
#: StructureDefinition.element.Extension/definition
msgid "A device request that is fulfilled in whole or in part by this device usage."
msgstr "Buyumdan bu foydalanish to'liq yoki qisman bajaradigan buyum so'rovi."
