# A short, descriptive, user-friendly title for the structure definition.
#: StructureDefinition.title
msgid "Based on device request"
msgstr "Asos - buyum so'rovi"

# A free text natural language description of the structure definition from a consumer's perspective.
#: StructureDefinition.description
msgid "A device request that is fulfilled in whole or in part by this device usage. FHIR R5 DeviceUsage.basedOn allows only ServiceRequest, and the standard event-basedOn extension has no DeviceUsage context, so this extension follows event-basedOn for DeviceUsage."
msgstr "Buyumdan bu foydalanish to'liq yoki qisman bajaradigan buyum so'rovi. FHIR R5 da DeviceUsage.basedOn faqat ServiceRequest ga ruxsat beradi, standart event-basedOn kengaytmasida esa DeviceUsage konteksti yo'q, shuning uchun bu kengaytma DeviceUsage uchun event-basedOn ni takrorlaydi."

# A concise description of what this element means (e.g. for use in autogenerated summaries).
#: StructureDefinition.element.Extension/short
msgid "Fulfilled device request"
msgstr "Bajarilayotgan buyum so'rovi"

# Provides a complete explanation of the meaning of the data element for human readability.
#: StructureDefinition.element.Extension/definition
msgid "A device request that is fulfilled in whole or in part by this device usage. FHIR R5 DeviceUsage.basedOn allows only ServiceRequest, and the standard event-basedOn extension has no DeviceUsage context, so this extension follows event-basedOn for DeviceUsage."
msgstr "Buyumdan bu foydalanish to'liq yoki qisman bajaradigan buyum so'rovi. FHIR R5 da DeviceUsage.basedOn faqat ServiceRequest ga ruxsat beradi, standart event-basedOn kengaytmasida esa DeviceUsage konteksti yo'q, shuning uchun bu kengaytma DeviceUsage uchun event-basedOn ni takrorlaydi."
