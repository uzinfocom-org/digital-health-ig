#: ImplementationGuide.definition.resource.description
msgid "Group membership bases"
msgstr "Guruhga a'zolik asoslari"

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Group membership basis supplement with translations in Uzbek and Russian"
msgstr "Guruhga a'zolik asosi to'ldirmasi, o'zbek va rus tillariga tarjimalari bilan"

