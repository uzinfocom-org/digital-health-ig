msgstr "Guruh turi to'ldirmasi, o'zbek va rus tillariga tarjimalari bilan"

# --- UZ Core PlanDefinition jurisdiction (resource descriptions) ---
# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Where in Uzbekistan an artifact applies - the whole country for national artifacts, or one of its regions for regional ones"
msgstr "Artefakt O'zbekistonning qayerida qo'llanilishi - milliy artefaktlar uchun butun mamlakat, hududiy artefaktlar uchun esa uning viloyatlaridan biri"

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Example type 2 diabetes screening schedule that applies in two regions only, showing one jurisdiction use context per region."
msgstr "Faqat ikki viloyatda qo'llaniladigan 2-tip qandli diabet skrining jadvali namunasi, har bir viloyat uchun bittadan jurisdiction foydalanish konteksti bilan."

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Example age-based national immunization schedule, showing the focus, category and jurisdiction use contexts, the vaccination actions, their timing, and the relationship between two doses."
msgstr "Yoshga asoslangan milliy emlash jadvali namunasi: focus, toifa va jurisdiction foydalanish kontekstlari, emlash action lari, ularning vaqti hamda ikki doza orasidagi bog'liqlik ko'rsatilgan."
