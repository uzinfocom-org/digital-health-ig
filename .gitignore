.DS_Store
Thumbs.db
/fsh-generated
/input-cache
/output*
/temp
/template
# source translations are autogenerated by the IG publisher and should be moved to /input/translations once updated
/translations/*
# scripts/_updatePublisher.sh downloads fresh wrapper scripts into the root; the IG Publisher reports committed root scripts as an error
/_build.*
/_genonce.*
/_gencontinuous.*
/_updatePublisher.*

.claude/
